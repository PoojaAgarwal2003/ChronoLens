{
  "name": "chronolens-web",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.17.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test:e2e": "npm run build && playwright test && playwright test --config playwright.snapshot.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "demo:capture": "npm run build && node showcase/run.mjs",
    "experiment:latency": "npm run build && node experiments/run.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.15",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  }
}
